{
  "name": "tiktok-growth-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start": "tsx --env-file-if-exists=.env server/index.ts --production",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "demo": "tsx scripts/demo.ts",
    "check": "npm run build && npm test && npm run test:e2e",
    "case:capture": "tsx scripts/capture-case.ts",
    "case:build": "node scripts/build-case.mjs",
    "case:verify": "tsx scripts/verify-case.ts"
  },
  "dependencies": {
    "cheerio": "^1.1.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "description": "TikTok商品理解、批量可拍脚本、素材规划与Content DNA复盘迭代工作区",
  "author": {
    "name": "越哥",
    "url": "https://github.com/bingyue"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingyue/tiktok-growth-studio.git"
  },
  "homepage": "https://github.com/bingyue/tiktok-growth-studio#readme",
  "bugs": {
    "url": "https://github.com/bingyue/tiktok-growth-studio/issues"
  },
  "license": "SEE LICENSE IN LICENSE"
}
